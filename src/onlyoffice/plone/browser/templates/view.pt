  <!-- The document name and metadata are already shown in the breadcrumb and
       in the ONLYOFFICE editor header. Drop the duplicate page title here and
       suppress the byline via a no-op viewlet (see viewlets.py / the viewlet
       override in configure.zcml). -->
  <metal:title fill-slot="content-title" />

  <metal:block fill-slot="content-core">
    <style type="text/css">
      /* ONLYOFFICE editor page layout.
         1) Hide the duplicate document byline (author / modified date) and the
            empty below-title strip so the editor sits directly under the
            breadcrumb. This is reliable regardless of byline settings
            elsewhere on the site, because this stylesheet only loads on the
            editor page. */
      .documentByline,
      #viewlet-below-content-title { display: none !important; }
      /* 2) Remove the gap above the editor. Different themes put the spacing on
            different wrappers, so zero the top margin/padding on all the usual
            content containers (this stylesheet only loads on the editor page). */
      #portal-column-content,
      #content,
      #content-core,
      .principal-content,
      main#content { margin-top: 0 !important; padding-top: 0 !important; }
      /* Any residual gap above the editor lives on a theme wrapper we don't
         control here, so pull the whole editor block up by ~half the gap.
         Tunable: make this more negative to tighten, less to loosen. */
      .onlyoffice-editor-wrap { position: relative; margin-top: -1rem; }
      /* 4) Docent bar above the editor: Rename and Save & Close, together
            on the right (2026-10-21). ONLYOFFICE's own header already shows
            the file name, so the bar does not repeat it. */
      .oo-docent-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
                       margin: -0.5rem 0 1.25rem; min-height: 36px; }
      .oo-docent-spacer { flex-grow: 1; }
      .oo-docent-rename { display: inline-flex; align-items: center; gap: 4px; height: 28px;
                          padding: 0 8px; border: 1px solid #DFD9D1; border-radius: 6px;
                          background: #FFFFFF; color: #1F5F6E; font-size: 12px; font-weight: 500;
                          cursor: pointer; }
      .oo-docent-rename:hover { border-color: #3A9FB5; }
      .oo-docent-rename-form { display: inline-flex; align-items: center; gap: 6px; }
      .oo-docent-rename-form input { height: 28px; font-size: 13px; padding: 0 8px; min-width: 260px;
                                     border: 1px solid #BAD8DE; border-radius: 6px; }
      .oo-docent-small { height: 28px; padding: 0 10px; border-radius: 6px; font-size: 12px;
                         border: 1px solid #DFD9D1; background: #FFFFFF; cursor: pointer; }
      .oo-docent-small.primary { background: #1F5F6E; border-color: #1F5F6E; color: #FFFFFF; }
      .oo-docent-note { font-size: 12px; color: #64041f; }
      .oo-docent-close { display: inline-flex; align-items: center; gap: 6px; height: 32px;
                         padding: 0 14px; border-radius: 999px; border: 1px solid #1F5F6E;
                         background: #1F5F6E; color: #FFFFFF; font-size: 11.2px; font-weight: 600;
                         cursor: pointer; }
      .oo-docent-close:hover { background: #17505D; border-color: #17505D; }
      /* Cancel: the Rename button's quiet shape, beside Save & Close. */
      .oo-docent-cancel { display: inline-flex; align-items: center; gap: 4px; height: 28px;
                          padding: 0 10px; border: 1px solid #DFD9D1; border-radius: 6px;
                          background: #FFFFFF; color: #64041f; font-size: 12px; font-weight: 500;
                          cursor: pointer; }
      .oo-docent-cancel:hover { border-color: #64041f; }
      .oo-docent-close[disabled] { opacity: .7; cursor: progress; }
      .oo-docent-bar [hidden] { display: none !important; }
      /* 5) The bar sits in #content-core, where the Docent theme paints every
            <button> as a coral outline: a 2px coral inset box-shadow, coral
            text (!important), Roboto Slab capitals, 3.5em tall. Its id
            selector beats the classes above, so the shape and colours are
            restated here with the id and !important. */
      #content-core .oo-docent-bar button {
        box-shadow: none !important; text-transform: none !important;
        letter-spacing: normal !important; font-family: inherit !important;
        line-height: 1 !important; min-height: 0 !important; text-decoration: none !important;
      }
      #content-core .oo-docent-rename {
        display: inline-flex !important; height: 28px !important; padding: 0 8px !important;
        border: 1px solid #DFD9D1 !important; border-radius: 6px !important;
        background: #FFFFFF !important; color: #1F5F6E !important;
        font-size: 12px !important; font-weight: 500 !important;
      }
      #content-core .oo-docent-rename:hover { border-color: #3A9FB5 !important; }
      #content-core .oo-docent-cancel {
        display: inline-flex !important; height: 28px !important; padding: 0 10px !important;
        border: 1px solid #DFD9D1 !important; border-radius: 6px !important;
        background: #FFFFFF !important; color: #64041f !important;
        font-size: 12px !important; font-weight: 500 !important;
      }
      #content-core .oo-docent-cancel:hover { border-color: #64041f !important; }
      #content-core .oo-docent-cancel[disabled] { opacity: .7 !important; cursor: progress !important; }
      #content-core .oo-docent-small {
        height: 28px !important; padding: 0 10px !important; border-radius: 6px !important;
        border: 1px solid #DFD9D1 !important; background: #FFFFFF !important;
        color: #212529 !important; font-size: 12px !important; font-weight: 500 !important;
      }
      #content-core .oo-docent-small.primary {
        background: #1F5F6E !important; border-color: #1F5F6E !important; color: #FFFFFF !important;
      }
      #content-core .oo-docent-close {
        display: inline-flex !important; height: 32px !important; padding: 0 14px !important;
        border-radius: 999px !important; border: 1px solid #1F5F6E !important;
        background: #1F5F6E !important; color: #FFFFFF !important;
        font-size: 11.2px !important; font-weight: 600 !important;
      }
      #content-core .oo-docent-close:hover,
      #content-core .oo-docent-small.primary:hover {
        background: #17505D !important; border-color: #17505D !important;
      }
      body.docent-dark #content-core .oo-docent-rename,
      body.docent-dark #content-core .oo-docent-cancel,
      body.docent-dark #content-core .oo-docent-small:not(.primary) {
        background: #1c222c !important; border-color: #3a4250 !important; color: #9fd0da !important;
      }
      /* The display rules above outrank 4)'s [hidden]; this one outranks them. */
      #content-core .oo-docent-bar [hidden] { display: none !important; }
    </style>
    <!-- Rename and Save & Close, on the right. Rename and
         Save are shown by the script below only when the editor opened for
         editing; a read-only view gets Close. -->
    <div class="oo-docent-bar"
         id="ooDocentBar"
    >
      <span class="oo-docent-spacer"></span>
      <span class="oo-docent-note"
            id="ooDocentNote"
            role="status"
      ></span>
      <!-- Not shown: the current name, for the Rename box and the
           "Changes saved" note. -->
      <span id="ooDocentName"
            hidden="hidden"
            tal:content="context/Title"
      >Title</span>
      <span class="oo-docent-rename-form"
            id="ooDocentRenameForm"
            hidden="hidden"
      >
        <input id="ooDocentRenameInput"
               aria-label="New name"
               type="text"
               i18n:attributes="aria-label"
        />
        <button class="oo-docent-small primary"
                id="ooDocentRenameSave"
                title="Save the new name"
                type="button"
                i18n:attributes="title"
                i18n:translate=""
        >Save name</button>
        <button class="oo-docent-small"
                id="ooDocentRenameCancel"
                title="Keep the current name"
                type="button"
                i18n:attributes="title"
                i18n:translate=""
        >Cancel</button>
      </span>
      <button class="oo-docent-rename"
              id="ooDocentRename"
              hidden="hidden"
              title="Rename this document (also renames the file)"
              type="button"
              i18n:attributes="title"
      >
        <svg aria-hidden="true"
             fill="none"
             height="13"
             stroke="currentColor"
             stroke-linecap="round"
             stroke-linejoin="round"
             stroke-width="1.4"
             viewbox="0 0 16 16"
             width="13"
        ><path d="M11.2 2.4 13.6 4.8 5.6 12.8 2.4 13.6 3.2 10.4z"></path></svg>
        <span i18n:translate="">Rename</span>
      </button>
      <!-- Cancel (5 Nov 2026): leave without keeping the edits. The
           document server would still write them back once the last
           editor is gone, so Cancel first marks the document (the
           onlyoffice-discard view) and the callback then throws that
           write away. Shown only when the editor opened for editing. -->
      <button class="oo-docent-cancel"
              id="ooDocentCancel"
              hidden="hidden"
              title="Leave without saving your changes"
              type="button"
              i18n:attributes="title"
      >
        <svg aria-hidden="true"
             fill="none"
             height="13"
             stroke="currentColor"
             stroke-linecap="round"
             stroke-linejoin="round"
             stroke-width="1.8"
             viewbox="0 0 16 16"
             width="13"
        ><path d="M4 4l8 8M12 4l-8 8"></path></svg>
        <span i18n:translate="">Cancel</span>
      </button>
      <button class="oo-docent-close"
              id="ooDocentClose"
              hidden="hidden"
              title="Save your changes to Docent and go back"
              type="button"
              i18n:attributes="title"
      >
        <svg aria-hidden="true"
             fill="none"
             height="13"
             stroke="currentColor"
             stroke-linecap="round"
             stroke-linejoin="round"
             stroke-width="1.8"
             viewbox="0 0 16 16"
             width="13"
        ><path d="M3 8.5 6.5 12 13 4.5"></path></svg>
        <span id="ooDocentCloseLabel"
              i18n:translate=""
        >Save &amp; Close</span>
      </button>
    </div>
    <div class="onlyoffice-editor-wrap">
      <!-- No Download button over the editor (2026-10-21): it sat on top
           of ONLYOFFICE's own header. Download stays in File > Download as,
           and in Docent's document lists. -->
      <div id="onlyofficeEditor"></div>
    </div>
    <div id="onlyofficeErrorNotAccessible"
         style="display:none;"
         i18n:translate=""
    >DocumentServer not accessible.</div>
    <div id="onlyofficeErrorNotSupportedVersion"
         style="display:none;"
         i18n:translate=""
    >Not supported version DocumentServer.</div>
    <div id="onlyofficeErrorNotSupportedVersionForm"
         style="display:none;"
         i18n:translate=""
    >Please update ONLYOFFICE Docs to version 7.0 to work on fillable forms
      online.</div>

    <a class="pat-plone-modal"
       id="insert-dialog-onlyoffice-triger"
       href="#insert-dialog-onlyoffice"
       style="display: none;"
       data-pat-plone-modal="width: 600px;"
    >
    </a>
    <div id="insert-dialog-onlyoffice"
         style="display: none"
         i18n:domain="plone"
    >
      <div class="linkModal">
        <h1 i18n:translate="label_select_content_item">Select a content item</h1>
        <div class="mb-3 field fieldname-form.widgets.fileTitle widget-mode-input False"
             id="fileTitle"
        >
          <label>
            <label class="form-label"
                   for="onlyoffice-file-title"
                   i18n:translate="label_title"
            >Title</label>
            <span class="required"
                  title="Required"
                  i18n:ignore-attributes="title"
            ></span>
          </label>
          <input class="form-control text-widget required textline-field"
                 id="onlyoffice-file-title"
                 name="onlyoffice.file.title"
                 required="required"
                 type="text"
          />
          <div class="fieldErrorBox"
               style="display: none"
               i18n:domain="onlyoffice.plone"
          >
            <em class="invalid-feedback"
                i18n:translate=""
            >Please fill out this field.</em>
          </div>
        </div>
        <div id="relatedItems"></div>
        <div class="formControls">
          <input class="btn submit-widget button-field btn-secondary"
                 name="cancel"
                 type="submit"
                 value="Cancel"
                 i18n:attributes="value label_cancel;"
          />
          <input class="btn submit-widget button-field btn-primary"
                 name="ok"
                 type="submit"
                 value="Ok"
                 i18n:attributes="value label_ok;"
          />
        </div>
      </div>
    </div>

    <script src="${view/docUrl}web-apps/apps/api/documents/api.js?shardkey=${view/documentKey}"
            type="text/javascript"
    ></script>
    <script language="javascript"
            type="text/javascript"
    >
      var docEditor;
      var config = ${view/editorCfg}
      var saveAs = ${view/saveAs}
      var demo = ${view/demo}
      config.width = "100%";
      config.height = "100%";

      // Make the editor fill the browser window from where it starts down to
      // the bottom of the page, instead of a fixed 600px that leaves blank
      // space below it. Re-applied on resize so it tracks the viewport.
      function resizeOnlyofficeEditor() {
        var el = document.querySelector('iframe[name="frameEditor"]') ||
                 document.getElementById("onlyofficeEditor");
        if (!el) { return; }
        var top = el.getBoundingClientRect().top + window.pageYOffset;
        el.style.height = Math.max(400, window.innerHeight - top) + "px";
      }
      window.addEventListener("resize", resizeOnlyofficeEditor);
      window.addEventListener("load", function () {
        setTimeout(resizeOnlyofficeEditor, 100);
      });

      var baseModalDialog = {
        createDialod: function (selectableTypes, titleValue = null) {
          var modalDialog = $("#insert-dialog-onlyoffice-triger").patPloneModal().data("pattern-plone-modal");

          var relatedItemsOptions = ${view/relatedItemsOptions}
          relatedItemsOptions.selectableTypes = selectableTypes;
          relatedItemsOptions.maximumSelectionSize = 1;

          var relatedItems = document.createElement("input");
          relatedItems.type = "text";
          relatedItems.className = "pat-relateditems";
          relatedItems.setAttribute("data-pat-relateditems", JSON.stringify(relatedItemsOptions));

          document.getElementById('relatedItems').innerHTML = "";
          document.getElementById('relatedItems').append(relatedItems);

          modalDialog.show();

          if(titleValue) {
            modalDialog.$modal.find("div#fileTitle").show();
            modalDialog.$modal.find("input#onlyoffice-file-title").val(titleValue);
          }

          modalDialog.$modal.find("div.pattern-modal-buttons input[name='cancel']").on("click", function () {
            modalDialog.hide();
          });

          return modalDialog;
        },
        setSubmitRequest: function (modalDialog, submitRequest) {
          modalDialog.$modal.find("div.pattern-modal-buttons input[name='ok']").on("click", submitRequest);
        }
      };

      var requestInsert = function (modalDialog, docEditorEvent, command = null) {
        var selectedItems = modalDialog.$modal.find("div.pat-relateditems").select2("data");
        var selectedUIDs = (selectedItems || []).map(
          function (el) {
            return el.UID;
          }
        );

        var request = new XMLHttpRequest();
        request.open("POST", "${context/absolute_url}/onlyoffice-insert", false);
        request.setRequestHeader("x-csrf-token", "${view/token}");
        request.send(JSON.stringify({
          command: command,
          UIDs: selectedUIDs
        }));

        if (request.status == 200) {
          var insertObjects = JSON.parse(request.responseText);

          // bug https://bugzilla.onlyoffice.com/show_bug.cgi?id=50683
          // insertObjects.forEach((insertObject) => {
          //    docEditorEvent(insertObject);
          // });

          docEditorEvent(insertObjects[0]);
          modalDialog.hide();
        }
      };

      var onAppReady = function () {
        if (demo) {
          docEditor.showMessage(demo.message);
        }
      };

      var onRequestInsertImage = function (event) {
        var insertImageDialog = baseModalDialog.createDialod(["Image"]);
        baseModalDialog.setSubmitRequest(insertImageDialog, function () {
          requestInsert(insertImageDialog, docEditor.insertImage, event.data.c);
        });
      };

      var onRequestCompareFile = function () {
        var insertFileDialog = baseModalDialog.createDialod(["File"]);
        baseModalDialog.setSubmitRequest(insertFileDialog, function () {
          requestInsert(insertFileDialog, docEditor.setRevisedFile);
        });
      };

      var onRequestMailMergeRecipients = function () {
        var insertFileDialog = baseModalDialog.createDialod(["File"]);
        baseModalDialog.setSubmitRequest(insertFileDialog, function () {
          requestInsert(insertFileDialog, docEditor.setMailMergeRecipients);
        });
      };

      var onRequestSaveAs = function (event) {
        var url = event.data.url;
        var fileTitle = event.data.title.substring(0, event.data.title.lastIndexOf("."));
        var fileType = event.data.fileType ? event.data.fileType : event.data.title.split(".").pop();

        var saveAsDialog = baseModalDialog.createDialod(["Folder"], fileTitle);
        saveAsDialog.$modal.find(".plone-modal-title").text(saveAs.title);
        saveAsDialog.$modal.find("div.pat-relateditems").append("<div class='formHelp'>" + saveAs.helpTitle + " </div>");

        baseModalDialog.setSubmitRequest(saveAsDialog, function () {
          var selectedItems = saveAsDialog.$modal.find("div.pat-relateditems").select2("data");
          var selectedUIDs = (selectedItems || []).map(
            function (el) {
              return el.UID;
            }
          );

          var fileTitle = saveAsDialog.$modal.find("input#onlyoffice-file-title").val();

          if (!fileTitle) {
            saveAsDialog.loading.hide();
            saveAsDialog.$modal.find("div#fileTitle").addClass("error");
            saveAsDialog.$modal.find("div#fileTitle div.fieldErrorBox").show();
            return;
          } else {
            saveAsDialog.$modal.find("div#fileTitle div.fieldErrorBox").hide();
          }

          var request = new XMLHttpRequest();
          request.open("POST", "${context/absolute_url}/onlyoffice-save-as", false);
          request.setRequestHeader("x-csrf-token", "${view/token}");
          request.send(JSON.stringify({
            url: url,
            fileType: fileType,
            fileTitle: fileTitle,
            folderUID: selectedUIDs[0]
          }));

          if (request.status == 200) {
            var response = JSON.parse(request.response);
            docEditor.showMessage(saveAs.messages.success + " " + response.fileName);
          } else if (request.status == 403) {
            docEditor.showMessage(saveAs.messages.errorNotAuthorized);
          } else {
            docEditor.showMessage(saveAs.messages.errorUnknown);
          }

          saveAsDialog.hide();
        });
      };

      // Fired by the document server in response to docEditor.downloadAs().
      // event.data.url points to the file built from the *current* editor
      // state, so this downloads the document exactly as it is on screen.
      var onDownloadAs = function (event) {
        // Save & Close asked for the live document: store it, then leave.
        // No browser download in that case.
        if (closing) {
          saveAndLeave(event.data.url);
          return;
        }
        // 1) hand the freshly built file to the browser.
        var link = document.createElement("a");
        link.href = event.data.url;
        link.download = config.document.title || "";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        // 2) persist that same file to Plone so the downloaded version is also
        // stored on the server. Only when the session can be saved back.
        var canPersist = !!(config.editorConfig && config.editorConfig.callbackUrl);
        if (canPersist) {
          try {
            var request = new XMLHttpRequest();
            request.open("POST", "${context/absolute_url}/onlyoffice-save-current", true);
            request.setRequestHeader("x-csrf-token", "${view/token}");
            request.onload = function () {
              if (request.status === 200) {
                showOnlyofficeMessage(downloadMessages.saved);
              } else {
                showOnlyofficeMessage(downloadMessages.notSaved);
              }
            };
            request.onerror = function () {
              showOnlyofficeMessage(downloadMessages.notSaved);
            };
            request.send(JSON.stringify({ url: event.data.url }));
          } catch (e) {
            // Best effort: the download has already happened.
            showOnlyofficeMessage(downloadMessages.notSaved);
          }
        } else {
          showOnlyofficeMessage(downloadMessages.downloaded);
        }
      };

      var downloadMessages = {
        saved: "Document downloaded and saved to the server.",
        notSaved: "Document downloaded, but it could not be saved to the server.",
        downloaded: "Document downloaded."
      };

      function showOnlyofficeMessage(text) {
        if (typeof docEditor !== "undefined" && docEditor && docEditor.showMessage) {
          docEditor.showMessage(text);
        }
      }

      var renameMessages = {
        renamed: "File renamed.",
        notRenamed: "The file could not be renamed."
      };

      // Fired when the user renames the document in the editor. event.data is
      // the new name without extension; the server updates both the Plone Title
      // and the stored file name (keeping the extension).
      var onRequestRename = function (event) {
        var newName = event.data;
        if (!newName) { return; }
        try {
          var request = new XMLHttpRequest();
          request.open("POST", "${context/absolute_url}/onlyoffice-rename", true);
          request.setRequestHeader("x-csrf-token", "${view/token}");
          request.onload = function () {
            showOnlyofficeMessage(
              request.status === 200 ? renameMessages.renamed : renameMessages.notRenamed
            );
          };
          request.onerror = function () {
            showOnlyofficeMessage(renameMessages.notRenamed);
          };
          request.send(JSON.stringify({ name: newName }));
        } catch (e) {
          showOnlyofficeMessage(renameMessages.notRenamed);
        }
      };

      // onDocumentStateChange fires with data === true when the document has
      // changes the document server has not taken yet. It used to put up a
      // File saved message each time they had gone, which read as saved in
      // Docent when it only meant saved on the document server (2026-10-21):
      // that message is gone. All this records now is that the document was
      // edited, for the "Changes saved" note after leaving.
      var everEdited = false;
      var onDocumentStateChange = function (event) {
        if (event.data) {
          everEdited = true;
        }
      };

      // ---- Docent bar: Rename, Cancel, and Save & Close ---------------------
      var closing = false;
      var NOTE_KEY = "docentChangesSaved";
      var canSave = !!(config.editorConfig && config.editorConfig.callbackUrl
                       && config.editorConfig.mode === "edit");
      var backUrl = (config.editorConfig && config.editorConfig.customization
                     && config.editorConfig.customization.goback
                     && config.editorConfig.customization.goback.url) || "..";
      var barName = document.getElementById("ooDocentName");
      var barNote = document.getElementById("ooDocentNote");
      var renameButton = document.getElementById("ooDocentRename");
      var renameForm = document.getElementById("ooDocentRenameForm");
      var renameInput = document.getElementById("ooDocentRenameInput");
      var closeButton = document.getElementById("ooDocentClose");
      var closeLabel = document.getElementById("ooDocentCloseLabel");
      var cancelButton = document.getElementById("ooDocentCancel");

      // The folder page shows a note when it finds this (the
      // ChangesSavedNote viewlet). Only after an edit. `saved` is true when
      // Save & Close stored the document before leaving ("Changes saved");
      // any other way out leaves the document server to write it back a
      // few seconds later ("Changes are being saved").
      function leaveNote(saved) {
        if (!everEdited) { return; }
        try {
          window.sessionStorage.setItem(NOTE_KEY, JSON.stringify(
            { name: barName.textContent || "", saved: !!saved }));
        }
        catch (e) { /* private window: no note */ }
      }

      function leave(saved) {
        leaveNote(saved);
        window.location.href = backUrl;
      }

      function closeFailed() {
        closing = false;
        closeButton.disabled = false;
        closeLabel.textContent = "Save & Close";
        closeButton.title = "Save your changes to Docent and go back";
        barNote.textContent = "Could not save. Your changes are still open here; try again.";
      }

      // Store the live document (the same save the old Download button made
      // alongside its download), then go back to the folder.
      function saveAndLeave(url) {
        try {
          var request = new XMLHttpRequest();
          request.open("POST", "${context/absolute_url}/onlyoffice-save-current", true);
          request.setRequestHeader("x-csrf-token", "${view/token}");
          request.onload = function () {
            if (request.status === 200) { leave(true); } else { closeFailed(); }
          };
          request.onerror = closeFailed;
          request.send(JSON.stringify({ url: url }));
        } catch (e) {
          closeFailed();
        }
      }

      if (canSave) {
        renameButton.hidden = false;
        cancelButton.hidden = false;
      } else {
        closeLabel.textContent = "Close";
        closeButton.title = "Close and go back";
      }
      closeButton.hidden = false;

      closeButton.addEventListener("click", function () {
        if (closing) { return; }
        // Nothing to save: a read-only view, or no edits made.
        if (!canSave || !everEdited
            || typeof docEditor === "undefined" || !docEditor || !docEditor.downloadAs) {
          leave();
          return;
        }
        closing = true;
        closeButton.disabled = true;
        closeLabel.textContent = "Saving...";
        barNote.textContent = "";
        docEditor.downloadAs();
      });

      function cancelFailed() {
        closing = false;
        cancelButton.disabled = false;
        barNote.textContent = "Could not cancel. Your changes are still open here; try again.";
      }

      // Cancel: go back without keeping the edits. The document server
      // writes a closed document back a few seconds later whatever the
      // page did, so the document is marked first (onlyoffice-discard) and
      // the callback drops that write. Asks first when there is something
      // to lose.
      cancelButton.addEventListener("click", function () {
        if (closing) { return; }
        if (everEdited && !window.confirm(
              "Leave without saving? The changes you made since opening this document will be lost.")) {
          return;
        }
        closing = true;
        cancelButton.disabled = true;
        barNote.textContent = "";
        try {
          var request = new XMLHttpRequest();
          request.open("POST", "${context/absolute_url}/onlyoffice-discard", true);
          request.setRequestHeader("x-csrf-token", "${view/token}");
          request.onload = function () {
            if (request.status === 200) { window.location.href = backUrl; } else { cancelFailed(); }
          };
          request.onerror = cancelFailed;
          request.send("{}");
        } catch (e) {
          cancelFailed();
        }
      });

      // Leaving any other way (breadcrumb, a link, the browser's Back): the
      // document server writes the edits back to Docent shortly after the
      // last editor closes, so the folder page may say so too.
      window.addEventListener("pagehide", function () {
        if (!closing) { leaveNote(false); }
      });

      function showRenameForm(show) {
        renameForm.hidden = !show;
        renameButton.hidden = show;
        if (show) {
          renameInput.value = barName.textContent;
          renameInput.focus();
          renameInput.select();
        }
      }

      function saveName() {
        var newName = renameInput.value.trim();
        if (!newName || newName === barName.textContent) {
          showRenameForm(false);
          return;
        }
        var request = new XMLHttpRequest();
        request.open("POST", "${context/absolute_url}/onlyoffice-rename", true);
        request.setRequestHeader("x-csrf-token", "${view/token}");
        request.onload = function () {
          if (request.status === 200) {
            barName.textContent = newName;
            barNote.textContent = "Renamed. The editor shows the new name next time the file opens.";
            showRenameForm(false);
          } else {
            barNote.textContent = renameMessages.notRenamed;
          }
        };
        request.onerror = function () { barNote.textContent = renameMessages.notRenamed; };
        request.send(JSON.stringify({ name: newName }));
      }

      renameButton.addEventListener("click", function () { showRenameForm(true); });
      document.getElementById("ooDocentRenameCancel").addEventListener("click", function () {
        showRenameForm(false);
      });
      document.getElementById("ooDocentRenameSave").addEventListener("click", saveName);
      renameInput.addEventListener("keydown", function (event) {
        if (event.key === "Enter") { event.preventDefault(); saveName(); }
        if (event.key === "Escape") { showRenameForm(false); }
      });

      config.events = {
        "onAppReady": onAppReady,
        "onDownloadAs": onDownloadAs,
        "onDocumentStateChange": onDocumentStateChange,
        "onRequestRename": onRequestRename,
        "onRequestInsertImage": onRequestInsertImage,
        "onRequestCompareFile": onRequestCompareFile,
        "onRequestMailMergeRecipients": onRequestMailMergeRecipients
      };


      if (saveAs.available) {
        config.events.onRequestSaveAs = onRequestSaveAs
      }

      // Called by the "Download" button. Asks the editor for the live document
      // (handled by onDownloadAs above). Falls back to the stored copy if the
      // editor has not loaded.
      function onlyofficeDownload() {
        if (typeof docEditor !== "undefined" && docEditor && docEditor.downloadAs) {
          docEditor.downloadAs();
        } else {
          window.location.href = "${context/absolute_url}/@@download/file";
        }
      }

      function initDocEditor() {
        if (typeof DocsAPI === "undefined") {
          document.getElementById("onlyofficeErrorNotAccessible").style.display = "block";
          return;
        }

        var docsVersion = DocsAPI.DocEditor.version().split(".");

        if (docsVersion[0] < 6 || docsVersion[0] == 6 && docsVersion[1] == 0) {
          document.getElementById("onlyofficeErrorNotSupportedVersion").style.display = "block";
          return;
        }

        if ((config.document.fileType === "docxf" || config.document.fileType === "oform")
          && docsVersion[0] < 7) {
          document.getElementById("onlyofficeErrorNotSupportedVersionForm").style.display = "block";
          return;
        }

        docEditor = new DocsAPI.DocEditor("onlyofficeEditor", config);
      }

      initDocEditor();
    </script>
  </metal:block>

</html>
